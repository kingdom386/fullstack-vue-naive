# Server port (1-65535)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Allowed CORS origin
# 开发环境默认为 http://localhost:5173；生产环境必须显式设置，否则启动会失败
CORS_ORIGIN=http://localhost:5173

# pino 日志级别：trace | debug | info | warn | error | fatal（默认开发 debug / 生产 info）
LOG_LEVEL=debug

# MySQL 连接串
# 开发环境默认为 mysql://root:root@localhost:3306/app；生产环境必须显式设置，否则启动会失败
DATABASE_URL=mysql://root:root@localhost:3306/app
