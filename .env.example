# docker compose 编排变量：复制为根目录 .env 后按需修改（.env 已被 .gitignore 忽略）

# ---- 后端（server）----
NODE_ENV=production
# 生产环境必须显式设置，且需与前端实际访问来源一致（HTTPS 覆盖下改为 https://你的域名）
CORS_ORIGIN=http://localhost:8080
# pino 日志级别：trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- 前端（client）端口映射 ----
# 默认配置：http://localhost:8080
CLIENT_PORT=8080
# HTTPS 覆盖配置（docker-compose.prod.yml）
HTTP_PORT=80
HTTPS_PORT=443

# ---- 镜像来源（可选）----
# 留空时使用本地构建的镜像；对接镜像仓库后可用 `docker compose pull && docker compose up -d --no-build` 部署
#SERVER_IMAGE=ghcr.io/<owner>/<repo>-server:latest
#CLIENT_IMAGE=ghcr.io/<owner>/<repo>-client:latest